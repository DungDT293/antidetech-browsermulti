@@ -31,6 +31,36 @@
 
 namespace blink {
 
+namespace {
+
+// The five default plugins reported by navigator.plugins in Google Chrome.
+constexpr const char* kDefaultPluginNames[] = {
+    "PDF Viewer",
+    "Chrome PDF Viewer",
+    "Chromium PDF Viewer",
+    "Microsoft Edge PDF Viewer",
+    "WebKit built-in PDF",
+};
+
+void AddDefaultPlugins(HeapVector<Member<PluginInfo>>& plugins,
+                       HeapVector<Member<MimeClassInfo>>& mimes) {
+  for (const char* name : kDefaultPluginNames) {
+    auto* plugin_info = MakeGarbageCollected<PluginInfo>(
+        String(name), String("internal-pdf-viewer"),
+        String("Portable Document Format"), Color::kTransparent, false);
+    for (const char* mime_type_name : {"application/pdf", "text/pdf"}) {
+      auto* mime_info = MakeGarbageCollected<MimeClassInfo>(
+          String(mime_type_name), String("Portable Document Format"),
+          *plugin_info, Vector<String>({"pdf"}));
+      plugin_info->AddMimeType(mime_info);
+      mimes.push_back(mime_info);
+    }
+    plugins.push_back(plugin_info);
+  }
+}
+
+}  // namespace
+
 void MimeClassInfo::Trace(Visitor* visitor) const {
   visitor->Trace(plugin_);
 }
